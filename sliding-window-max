//O(n * k) shittiest way possible
//basically check every possible window over and over again
vector<int> slow_solve(vector<int>& v, int k) {
    vector<int> ans;
    int upto = v.size() - k, track;
    //last element = n - 1 --> n - 1 - k + 1 = n - k
    for (int i = 0; i <= upto; i++) {
        track = INT_MIN;
        for (int j = i; j < i + k; j++) track = max(track, v[j]);
        ans.pb(track);
    }
    return ans;
}

//core idea behind speedup
//move a sliding window
//you pop an element from start and push a new one at end
//this looks like a queue
//what if you explicitly knew the max for the first possible window
//then slided that
//problem? how do you know what element you removed?
//observation: is it possible to consider only some candidates?
//if I am guaranteed to pop from the start and push to the end
//does it make sense to keep a smaller element coming before a larger?
//no, because that window will remove the smaller first, so it can never be max
//but because i can use a max candidate, i need to be able to pop from the start
//so not a queue, a deque
vector<int> solve(vector<int>& v, int k) {
    vector<int> ans;
    deque<int> dq;
    int upto = v.size() - k, c;
    for (int i = 0; i < k; i++) {
        c = v[i];
        while (!dq.empty() && dq.back() < c) dq.pop_back();
        dq.pb(c);
    }
    //first window constructed, now slide
    ans.pb(dq[0]);
    for (int i = 1; i <= upto; i++) {
        c = v[i + k - 1];
        while (!dq.empty() && dq.back() < c) dq.pop_back();
        dq.pb(c);
        if (v[i - 1] == dq[0]) dq.pop_front();
        ans.pb(dq[0]);
    }
    return ans;
}
